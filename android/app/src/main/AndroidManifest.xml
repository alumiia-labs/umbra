<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- IMP-168: the cost of the network decides an automatic download. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The scanner of an invitation and of a safety number. A device with
         no camera pastes a link and compares a short code. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- IMP-048: the platform backup carries no UMBRA data, and a library
         manifest cannot set the value again. IMP-050: a device-to-device
         transfer carries none either. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Umbra"
        tools:replace="android:allowBackup">
        <!-- A turn or a resize keeps the activity, thus the open views stay,
             and no view state goes to a bundle outside the store. The empty
             task affinity keeps the activity of another app out of this
             task: Android 10 lets such an activity lie above the unlock
             view. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- IDN-123: a tap on an invitation link opens the app, and the
                 host serves the assetlinks.json of IDN-122. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${invitationHost}"
                    android:path="/i" />
            </intent-filter>
            <!-- IDN-130: a reusable link of Part 4 §4.3.2 starts a request. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="umbra"
                    android:host="p" />
                <!-- Part 9 §9.3.1: the link of a handle with its profile. -->
                <data
                    android:scheme="umbra"
                    android:host="h" />
            </intent-filter>
            <!-- A link that another app shares as text. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Part 8 §8.4.1: `specialUse`, and never `dataSync`, which the
             platform ends after 6 hours in 24. -->
        <service
            android:name=".DeliveryService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="An end-to-end encrypted messenger holds one connection to its relay, thus a message arrives with no push provider." />
        </service>

        <!-- Part 8 §8.3: the fixed clock of Private mode. -->
        <receiver
            android:name=".PrivateClock"
            android:exported="false" />

        <!-- NTF-045: Firebase makes no token by itself. Instant mode turns
             the token on, and each other mode deletes it (Push.kt). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- Part 8 §8.4.1: the FCM carrier. A build with no Firebase app
             gets no event here. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
