* text=auto

*.md text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# A continued RUN line with CRLF line ends does not parse.
Dockerfile text eol=lf
*.html text eol=lf
# A shell script with CRLF line ends does not run on Linux or macOS.
android/gradlew text eol=lf
*.bat text eol=crlf
*.jar binary
# The vector corpora keep the bytes whose hash PROVENANCE.md records, on
# each platform.
tests/vectors/** text eol=lf
# The scripts and templates of a container run on Linux.
deploy/relay/** text eol=lf
deploy/helm/** text eol=lf
