# The settings of one server for compose.yaml. Copy this file to .env in
# the root of the repository on that server, and fill it in. The values
# match deploy/ansible/group_vars/all.yml and inventory.example.yml.
# deploy/docker/README.md gives the steps.

# The services of this server. Each server takes tls; the relay servers take
# relay1 and relay2; east-1 also takes ndr, west-1 directory. The signer
# server takes signer alone with tls.
COMPOSE_PROFILES=tls,relay1,relay2

# The image. A registry image (ghcr.io/<owner>/umbra-servers:<tag>) spares
# each server the build.
UMBRA_IMAGE=umbra-servers

# The state of each service, on this server. Back up <root>/signer offline
# on the signer server.
UMBRA_ROOT=/srv/umbra

# The name of this server, with an A record to its address, and that
# address. A relay states both in its descriptor.
UMBRA_FQDN=east-1.umbrachat.app
UMBRA_ADDRESS=203.0.113.10

# The same on each server: the one operator, its family (openssl rand -hex
# 32, made one time and kept), the country of this server, and the
# autonomous system of the provider (whois <address>; OVH: 16276).
UMBRA_OPERATOR=umbra-project
UMBRA_FAMILY=
UMBRA_COUNTRY=US
UMBRA_ASN=16276

# The HTTPS carrier of the manifest: <host name>,<IPv4 address>,<port>.
UMBRA_SIGNER=signer-west-1.umbrachat.app,203.0.113.21,443

# --- Relays (profiles relay1 and relay2) ------------------------------------
# role: entry, middle or exit. An entry relay takes port 443 and class 1 or
# more. class: 0 = 100, 1 = 250, 2 = 500, 3 = 1000 Mbit/s; two relays of one
# server state the share of each. Each name is unique in the network.
RELAY1_NAME=entry-east
RELAY1_ROLE=entry
RELAY1_CLASS=1
RELAY1_PORT=443
RELAY2_NAME=exit-1
RELAY2_ROLE=exit
RELAY2_CLASS=1
RELAY2_PORT=9443
# An exit relay holds the chunks of Part 12 in memory, and it reads each one
# two times at its start. Its limit is two times UMBRA_CHUNK_CAPACITY and its
# queues.
RELAY2_MEMORY_HIGH=2300m
RELAY2_MEMORY_MAX=2500m
UMBRA_CHUNK_CAPACITY=1073741824

# An entry relay forwards the OHTTP requests of its clients to the gateway
# on ANOTHER server (Part 8 NTF-002). Leave a line empty on the server of
# that gateway.
UMBRA_OHTTP_GATEWAY=
UMBRA_DIRECTORY_GATEWAY=https://west-1.umbrachat.app:8443/gateway

# An exit relay pushes through an entry relay on another server than the
# notification server, and it reaches the directory the same way. The two
# hex values come from the ndr and directory servers (README, step 3).
UMBRA_NDR_ROUTE=https://west-1.umbrachat.app/ohttp
UMBRA_NDR_KEY_CONFIG=
UMBRA_DIRECTORY_ROUTE=https://east-1.umbrachat.app/directory
UMBRA_DIRECTORY_PINS=

# --- The notification server and the directory ------------------------------
# Only the relay servers reach this port (README, "Firewall").
UMBRA_SERVICE_PORT=8443

# --- The signer server (profile signer) -------------------------------------
# Each relay of the network: <name>,<role>,<class>, with a space between two.
UMBRA_RELAYS="entry-east,entry,1 exit-1,exit,1 middle,middle,1 exit-3,exit,1 entry-west,entry,1 exit-2,exit,1"
# The rate of the plan of this server, in Mbit/s. A test of a class needs
# 2.25 times the rate of the class (Part 10 §10.3).
UMBRA_MEASURER_CAPACITY=500
UMBRA_MEASURER_CERT_EPOCHS=24
# Revoked measurer certificates (Part 10 REL-105): <id>,<not_after>, with a
# space between two.
UMBRA_REVOKED_MEASURERS=
# The key directory under <root>/signer. A rotation moves it (README).
UMBRA_SIGNER_KEYS_DIR=keys
