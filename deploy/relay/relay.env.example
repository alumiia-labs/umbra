# The settings of your relay. Copy this file to .env in the root of the
# repository, and fill it in. README.md in this directory explains each
# value. The image holds the values of the network.

# certbot gets the certificate of UMBRA_HOST from Let's Encrypt on port 80.
# Set this line empty when you put your own certificate in data/tls.
COMPOSE_PROFILES=certbot

# A name for this relay: a-z, 0-9 and -. The owner of the network can give
# it another name when it admits the relay.
UMBRA_RELAY_NAME=

# middle: the middle of a chain. It needs the least, and it sees no client
#         address and no queue.
# exit:   the last relay of a chain. It holds message queues and file
#         chunks, thus it needs memory and a stable machine.
# entry:  the first relay, which phones reach. It needs port 443 and class
#         1 or more.
UMBRA_RELAY_ROLE=middle

# The rate that you give to the relay, in both directions, upload too:
# 0 = 100, 1 = 250, 2 = 500, 3 = 1000 Mbit/s. The network lists no relay
# below 100 Mbit/s. A test of the network verifies the class.
UMBRA_RELAY_CLASS=0

# A DNS name with an A record to your public IPv4 address, and that
# address. A dynamic DNS name works. A relay behind carrier-grade NAT
# does not work: the address must reach this machine.
UMBRA_HOST=
UMBRA_ADDRESS=

# The port of the relay. Forward it on your router to this machine. A port
# below 1024 needs a setting on the host (README.md). An entry relay takes
# 443.
UMBRA_PORT=9443

# Who you are, for the owner of the network (Part 10 §10.6): your name or
# the name of your group, and an address for abuse and legal reports. The
# join request holds them; the relay itself does not publish them.
UMBRA_OPERATOR=
UMBRA_CONTACT=

# The country of this machine (ISO 3166-1 alpha-2, as DE or US), and the
# autonomous system of your provider: `whois <your address>` names it
# (origin, OriginAS, or aut-num). Write the number alone.
UMBRA_COUNTRY=
UMBRA_ASN=

# Your relays as one family. Leave it empty for one relay. For two or more
# relays, make one value (openssl rand -hex 32) and give it to each.
UMBRA_FAMILY=

# The state of the relay: its keys, its queues, and the certificate. Back
# it up. A new key makes a new relay, which waits for its admission again.
# Keep it at ./data or outside the clone: `docker compose build` reads each
# other directory of the clone.
UMBRA_ROOT=./data

# The memory of the relay. An exit relay reads its chunks two times into
# memory at its start: give it two times UMBRA_CHUNK_CAPACITY and 300 MiB
# more, as 2300m and 2500m for the default capacity of 1 GiB. An exit relay
# with a lower limit does not start.
UMBRA_MEMORY_HIGH=1200m
UMBRA_MEMORY_MAX=1400m
# UMBRA_CHUNK_CAPACITY=1073741824

# The image. Leave it empty for the release image of this version.
# UMBRA_IMAGE=
