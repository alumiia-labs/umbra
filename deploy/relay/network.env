# The public values of the UMBRA network, for a relay of deploy/relay. Do
# not change this file: scripts/release-network.sh writes the key lines. The
# image holds this file and the key set of the app. Each value is public.

# The HTTPS carrier of the manifest: <host name>,<IPv4 address>,<port>.
UMBRA_SIGNER=signer-west-1.umbrachat.app,15.204.120.207,443

# An entry relay forwards the OHTTP requests of phones to these gateways.
UMBRA_OHTTP_GATEWAY=https://east-1.umbrachat.app:8443/gateway
UMBRA_DIRECTORY_GATEWAY=https://west-1.umbrachat.app:8443/gateway

# An exit relay pushes, and it reads the keys of the issuer, through these
# routes.
UMBRA_NDR_ROUTE=https://west-1.umbrachat.app/ohttp
UMBRA_DIRECTORY_ROUTE=https://east-1.umbrachat.app/directory
UMBRA_NDR_KEY_
UMBRA_DIRECTORY_
