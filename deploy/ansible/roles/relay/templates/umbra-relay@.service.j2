[Unit]
Description=UMBRA relay %i (Parts 3 and 10)
# A root is valid for three hours, and a wrong clock rejects it (Part 10
# §10.5.2). Thus the service starts after chrony sets the clock.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
User=umbra-relay
Group=umbra-relay
ExecStart=/usr/local/bin/umbra-relay /etc/umbra/relays/%i/relay.conf
Restart=on-failure
RestartSec=5
# Port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
LimitCORE=0
ReadWritePaths=/var/lib/umbra-relay/%i
LimitNOFILE=65536
# One relay never takes the memory of the others on this server. The file
# umbra-relay@<name>.service.d/10-umbra.conf gives an exit relay its own
# limit, and hides the files of the other relays of this server.
MemoryHigh={{ umbra_relay_memory_high }}
MemoryMax={{ umbra_relay_memory_max }}

[Install]
WantedBy=multi-user.target
