[Unit]
Description=UMBRA intake: the address, the port test, and the join request of a relay (Part 10)
After=network-online.target
Wants=network-online.target

[Service]
User=umbra-intake
Group=umbra-intake
ExecStart=/usr/local/bin/umbra-intake /etc/umbra-intake.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# The port test dials the address of a relay.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
LimitCORE=0
CapabilityBoundingSet=
# The intake writes the inbox alone. The keys of the signer are in another
# directory, which this user cannot read.
ReadWritePaths=/var/lib/umbra-intake/inbox
InaccessiblePaths=-/var/lib/umbra-signer
MemoryHigh={{ umbra_service_memory_high }}
MemoryMax={{ umbra_service_memory_max }}

[Install]
WantedBy=multi-user.target
