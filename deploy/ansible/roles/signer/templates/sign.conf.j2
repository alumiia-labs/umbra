# Written by Ansible (deploy/ansible/roles/signer). The inventory gives
# each relay, its class, and its place.
keys={{ umbra_signer_keys }}
out=/var/www/umbra/.well-known/umbra
keychain=/var/lib/umbra-signer/keychain
# Part 10 REL-198: the signer places the relays of its own operator at once.
# Each relay of another operator waits in its pending root (§10.5.4), and
# admission_state holds the first pending root of each one.
own_operator={{ umbra_operator }}
{% for host in groups['relays'] %}
{% for relay in hostvars[host]['relays'] %}
{% set place = 'ingress' if relay.role == 'entry' else relay.role %}
relay=/etc/umbra-signer/descriptors/{{ relay.name }}.desc,{{ umbra_operator }},{{ relay.class }},{{ place }}
{% endfor %}
{% endfor %}
{% for relay in umbra_outside_relays %}
{% set place = 'ingress' if relay.role == 'entry' else relay.role %}
relay=/etc/umbra-signer/descriptors/{{ relay.name }}.desc,{{ relay.operator }},{{ relay.class }},{{ place }}
{% endfor %}
admission_state=/var/lib/umbra-signer/state/admission_state
# The report queue and the verdicts of the authority tool
# (roles/authority). A file that is not there yet gives none.
report_queue=0,/var/lib/umbra-authority/report-queue.bin
verdicts=/var/lib/umbra-authority/verdicts
# The class tests of the measurer (roles/measurer), and the listed class of
# each relay with the epoch of its last step up (Part 10 REL-001).
results=/var/lib/umbra-measurer/results
class_state=/var/lib/umbra-signer/state/class_state
{% for measurer in umbra_revoked_measurers %}
revoked={{ measurer.id }},{{ measurer.not_after }}
{% endfor %}
