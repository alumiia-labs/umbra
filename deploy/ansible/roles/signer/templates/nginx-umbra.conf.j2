# Written by Ansible (deploy/ansible/roles/signer). The HTTPS carrier of
# Part 3 §3.10: the manifest, with no log of who fetched it, and the intake
# of Part 10 §10.6.4. Before
# the first rotation of the key set no key chain exists, and each request
# for it gets 404 (Part 10 REL-199). The error log would then hold the
# address of each app and each relay that asked, thus it is off too.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ inventory_hostname }}.{{ umbra_domain }};

    ssl_certificate /etc/umbra/tls/cert.pem;
    ssl_certificate_key /etc/umbra/tls/key.pem;
    ssl_protocols TLSv1.3;

    server_tokens off;
    access_log off;
    error_log /dev/null crit;
    log_not_found off;
    root /var/www/umbra;

    location = /.well-known/umbra/manifest {
        default_type application/octet-stream;
        add_header Cache-Control "no-cache" always;
    }

    # Part 10 REL-199: each rotation of the key set since the first one.
    location = /.well-known/umbra/keychain {
        default_type application/octet-stream;
        add_header Cache-Control "no-cache" always;
    }

    # Part 10 §10.6.4: the intake, for a relay that wants to join. The
    # intake takes the address of the relay from this header alone, and
    # nginx sets it over a header of the same name in the request.
    location ~ ^/\.well-known/umbra/(whoami|join|join/[0-9a-f]+|reach/[0-9]+)$ {
        limit_except GET POST {
            deny all;
        }
        client_max_body_size 16k;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_pass http://127.0.0.1:{{ umbra_intake_port }};
    }

    location / {
        return 404;
    }
}
