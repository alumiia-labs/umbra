[Unit]
Description=UMBRA measurer: the class test of each relay (Part 10 §10.3)
# Each run takes a new certificate first. A certificate lives
# {{ umbra_measurer_cert_epochs }} hours, and a run takes minutes.
After=network-online.target time-sync.target umbra-measurer-cert.service
Wants=network-online.target time-sync.target
Requires=umbra-measurer-cert.service
# A run fails when a relay gave no result. The operator must learn of it:
# a relay with no result keeps its class.
OnFailure=umbra-alert@%N.service

[Service]
Type=oneshot
User=umbra-measurer
Group=umbra-measurer
ExecStart=/usr/local/bin/umbra-measurer run /etc/umbra-measurer/measurer.conf
TimeoutStartSec=30min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# The signer reads the results that this unit writes.
UMask=0022
LimitCORE=0
LimitNOFILE=4096
ReadWritePaths=/var/lib/umbra-measurer
# One service never takes the memory of the others on this server.
MemoryHigh={{ umbra_service_memory_high }}
MemoryMax={{ umbra_service_memory_max }}
