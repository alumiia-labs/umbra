#!/usr/sbin/nft -f
# Written by Ansible (deploy/ansible/roles/common). Each change here goes
# away at the next run.
#
# The file replaces its own table alone. A flush of the whole rule set
# would also drop the table of fail2ban, and with it each SSH ban. The
# first line makes the table when it is not there, thus the delete of the
# second line never fails.
table inet filter
delete table inet filter

{% set relay_addresses = groups['relays'] | map('extract', hostvars, 'ansible_host') | list %}
{# An outside entry relay forwards the OHTTP requests of phones to the
   gateways too (NTF-002). #}
{% set relay_addresses = relay_addresses + (umbra_outside_relays | selectattr('role', 'equalto', 'entry') | map(attribute='address') | list) %}
{% set ns = namespace(relay_addresses6=[]) %}
{% for host in groups['relays'] if hostvars[host].umbra_ipv6 is defined %}
{% set ns.relay_addresses6 = ns.relay_addresses6 + [hostvars[host].umbra_ipv6] %}
{% endfor %}
table inet filter {
  set relays4 {
    type ipv4_addr
{% if relay_addresses %}
    elements = { {{ relay_addresses | join(', ') }} }
{% endif %}
  }

  # The IPv6 address of each relay server that states umbra_ipv6.
  set relays6 {
    type ipv6_addr
{% if ns.relay_addresses6 %}
    elements = { {{ ns.relay_addresses6 | join(', ') }} }
{% endif %}
  }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    meta l4proto { icmp, ipv6-icmp } accept

{% set ssh6 = umbra_ssh_from | select('search', ':') | list %}
{% set ssh4 = umbra_ssh_from | reject('search', ':') | list %}
{% if umbra_ssh_from %}
    # SSH from the addresses of umbra_ssh_from alone. A family with no
    # address in that list is closed, and the rule says so. The assert of
    # roles/common/tasks/main.yml stops a run whose list holds no address
    # of the family that Ansible reaches this server by.
{% if ssh4 %}
    tcp dport 22 ip saddr { {{ ssh4 | join(', ') }} } accept
{% else %}
    # umbra_ssh_from holds no IPv4 address: SSH is closed to IPv4.
    meta nfproto ipv4 tcp dport 22 drop
{% endif %}
{% if ssh6 %}
    tcp dport 22 ip6 saddr { {{ ssh6 | join(', ') }} } accept
{% else %}
    # umbra_ssh_from holds no IPv6 address: SSH is closed to IPv6.
    meta nfproto ipv6 tcp dport 22 drop
{% endif %}
{% else %}
    tcp dport 22 accept
{% endif %}
    # Let's Encrypt proves the name on port 80.
    tcp dport 80 accept
{% if inventory_hostname in groups['relays'] %}
    # Each relay of this server, on its own port.
{% for relay in hostvars[inventory_hostname]['relays'] %}
    tcp dport {{ relay.port }} accept
{% endfor %}
{% endif %}
{% if inventory_hostname in groups['signer'] %}
    tcp dport 443 accept
{% endif %}
{% if inventory_hostname in groups['ndr'] or inventory_hostname in groups['directory'] %}
    # The gateways of the notification server and the directory answer the
    # OHTTP relays of the network alone.
    tcp dport {{ umbra_service_port }} ip saddr @relays4 accept
    tcp dport {{ umbra_service_port }} ip6 saddr @relays6 accept
{% endif %}
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
