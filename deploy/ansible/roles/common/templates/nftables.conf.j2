#!/usr/sbin/nft -f
# Written by Ansible (deploy/ansible/roles/common). Each change here goes
# away at the next run.
flush ruleset

{% set relay_addresses = groups['relays'] | map('extract', hostvars, 'ansible_host') | list %}
table inet filter {
  set relays4 {
    type ipv4_addr
{% if relay_addresses %}
    elements = { {{ relay_addresses | join(', ') }} }
{% endif %}
  }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    meta l4proto { icmp, ipv6-icmp } accept

{% if umbra_ssh_from %}
    tcp dport 22 ip saddr { {{ umbra_ssh_from | join(', ') }} } accept
{% else %}
    tcp dport 22 accept
{% endif %}
    # Let's Encrypt proves the name on port 80.
    tcp dport 80 accept
{% if inventory_hostname in groups['relays'] or inventory_hostname in groups['signer'] %}
    tcp dport 443 accept
{% endif %}
{% if inventory_hostname in groups['ndr'] or inventory_hostname in groups['directory'] %}
    # The gateways of the notification server and the directory answer the
    # OHTTP relays of the network alone.
    tcp dport {{ umbra_service_port }} ip saddr @relays4 accept
{% endif %}
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
