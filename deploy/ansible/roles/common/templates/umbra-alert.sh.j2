#!/bin/sh
# Written by Ansible (deploy/ansible/roles/common). It tells the operator
# that a unit failed. journald also writes a line of the highest priority
# to each open terminal.
set -u

unit="${1:-a unit}"
message="UMBRA: $unit failed on $(hostname). See: journalctl -u $unit -n 50"
logger -p daemon.emerg -t umbra-alert "$message"
{% if umbra_alert_command %}
if ! {{ umbra_alert_command }} "$unit"; then
    logger -p daemon.crit -t umbra-alert "the alert command failed for $unit"
fi
{% endif %}
