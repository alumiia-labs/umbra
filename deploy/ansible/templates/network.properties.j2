# Written by Ansible (deploy/ansible/site.yml). Public values alone.
# The carriers of the manifest (Part 3 §3.10): the servers of the entry
# relays, which the app reaches anyway on port 443, and the signer.
{% set ns = namespace(entries=[]) %}
{% for host in groups['relays'] %}
{% if hostvars[host]['relays'] | selectattr('role', 'equalto', 'entry') | list %}
{% set ns.entries = ns.entries + [host] %}
{% endif %}
{% endfor %}
{% set carriers = ns.entries + groups['signer'] %}
carriers={% for host in carriers %}{{ host }}.{{ umbra_domain }},{{ hostvars[host]['ansible_host'] }}{{ ';' if not loop.last else '' }}{% endfor %}

{# NTF-002: the OHTTP relay sees the address of the app, and the gateway
   sees what the app sends. The two sit on two servers, thus one who breaks
   into one server links no address to a push registration. The same holds
   for the directory. roles/common fails the run with no such server. #}
{% set ndr_route = (ns.entries | difference(groups['ndr']))[0] %}
{% set directory_route = (ns.entries | difference(groups['directory']))[0] %}
# NTF-127 and DIS-163: the app reaches the two gateways through the OHTTP
# relay of an entry relay on another server than the gateway (NTF-002).
ndr_relay=https://{{ ndr_route }}.{{ umbra_domain }}/ohttp,{{ hostvars[ndr_route]['ansible_host'] }}
directory_relay=https://{{ directory_route }}.{{ umbra_domain }}/directory,{{ hostvars[directory_route]['ansible_host'] }}
invitation_host={{ umbra_invitation_host | default(umbra_domain) }}
